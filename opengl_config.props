<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <ItemDefinitionGroup>

    <ClCompile>
      <AdditionalIncludeDirectories>
$(MSBuildThisFileDirectory)openGLTools\dependencias\GLEW\include;
$(MSBuildThisFileDirectory)openGLTools\dependencias\GLFW\include;
$(MSBuildThisFileDirectory)openGLTools\vendor;
$(MSBuildThisFileDirectory)openGLTools\vendor\imgui;
%(AdditionalIncludeDirectories)
	</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>GLEW_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>

    <Link>
      <AdditionalLibraryDirectories>$(MSBuildThisFileDirectory)openGLTools\dependencias\GLFW\lib;$(MSBuildThisFileDirectory)openGLTools\dependencias\GLEW\lib\Release\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>glew32s.lib;glfw3.lib;Gdi32.lib;Opengl32.lib;User32.lib;Shell32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)openGLTools\vendor\imgui\*.cpp" />
  </ItemGroup>
</Project>